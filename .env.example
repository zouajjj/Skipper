DATABASE_URL=postgresql://localhost/skipper

# Transit adapters — only fill the ones you have
WMATA_API_KEY=          # DC Metro — register at developer.wmata.com
CTA_API_KEY=            # Chicago CTA — register at transitchicago.com/developers
MTA_API_KEY=            # NYC MTA — register at bustime.mta.info
TFL_APP_ID=              # London TfL — optional, increases rate limit
TFL_APP_KEY=             # London TfL — pair with TFL_APP_ID

# MARTA requires no key

PORT=3000
